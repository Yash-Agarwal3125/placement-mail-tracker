APP_ENV=development
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# SQLite
DATABASE_URL=sqlite:///data/placement_mail_tracker.db

# Gmail API
GMAIL_CREDENTIALS_FILE=config/credentials.json
GMAIL_TOKEN_FILE=config/token.json
GMAIL_QUERY=newer_than:7d
GMAIL_MAX_RESULTS=10

# AI extraction backend: "gemini" (default) or "groq". Groq's free tier is
# far more generous than Gemini's 20 req/day.
AI_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# Live-call ceiling per email = GEMINI_MAX_MODELS_TO_TRY * GEMINI_MAX_RETRIES.
GEMINI_MAX_RETRIES=1
GEMINI_MAX_MODELS_TO_TRY=2
GEMINI_RETRY_DELAY_SECONDS=1.0

# Groq API (only used when AI_PROVIDER=groq). llama-3.3-70b-versatile /
# llama-3.1-8b-instant were deprecated 2026-06-17 and fully shut down
# 2026-08-16 -- do not use them. These are Groq's own recommended successors.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=["openai/gpt-oss-20b"]
# On a per-minute (TPM/RPM) rate limit, wait and retry the same model instead
# of falling back to a weaker model or the rule-only result.
AI_RATE_LIMIT_WAIT_SECONDS=45.0
AI_RATE_LIMIT_MAX_RETRIES=2

# Google Sheets
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SHEET_RANGE=Sheet1!A1
GOOGLE_SHEET_NAME=Opportunities
GOOGLE_SHEETS_CREDENTIALS_FILE=config/credentials.json
GOOGLE_SHEETS_TOKEN_FILE=config/sheets_token.json

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Email SMTP notifications
SMTP_EMAIL=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-gmail-app-password
NOTIFICATION_EMAIL=alerts@example.com
EMAIL_RECEIVER=receiver@example.com
# Per-drive push alerts (<4h/<24h/<48h deadline/event reminders) on top of
# the daily digest. Off by default -- flip to true for real-time pings.
URGENT_ALERTS_ENABLED=false

# Scheduler
SYNC_INTERVAL_HOURS=3
FAILURE_ALERT_THRESHOLD=3
HEARTBEAT_INACTIVITY_HOURS=6
SYSTEM_HEALTH_FILE=data/system_health.json
HEARTBEAT_FILE=data/heartbeat.json
